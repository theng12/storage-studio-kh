{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Storage Studio KH",
  "mainBinaryName": "Storage Studio KH",
  "version": "0.1.21",
  "identifier": "app.storagestudiokh.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "Storage Studio KH",
        "width": 820,
        "height": 640,
        "minWidth": 700,
        "minHeight": 520,
        "visible": false,
        "resizable": true,
        "minimizable": false,
        "tabbingIdentifier": "storage-studio-kh"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "KH Studio Local Signing",
      "hardenedRuntime": false,
      "infoPlist": "Info.plist",
      "files": {
        "Helpers/Storage Studio KH Helper.app": "helper/Storage Studio KH Helper.app",
        "Resources/whats-new.json": "whats-new.json"
      }
    }
  }
}
